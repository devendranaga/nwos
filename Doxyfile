# Core build configuration
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = NO
GENERATE_XML           = YES
RECURSIVE              = YES
INPUT                  = .
FILE_PATTERNS          = *.c *.h

# Force Doxygen to look everywhere in your repository
INPUT                  = .

# Ensure it explicitly looks for C source and header files
FILE_PATTERNS          = *.c *.h

# Extract documentation from all functions, even if they aren't marked 'public'
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Clear out any default project-naming conflicts
PROJECT_NAME           = "C Code Documentation"
