{
    "network_config": {
        "interface_list": [
            "dummy0",
            "dummy1"
        ],
        "logging": {
            "debug_log_server_ip": "127.0.0.1",
            "debug_log_server_port": 12000,
            "log_pcap": true,
            "pcap_file_path": "./netos_pcap"
        },
        "arp_config": {
            "arp_table_len": 64
        },
        "filter": {
            "drop_ipv4_fragments": true
        },
        "egress": {
            "number_of_queues": 8,
            "egress_algorithm": "round_robin"
        },
        "ids": {
            "events": {
                "event_forwarding": {
                    "enable": false,
                    "server_ip": "127.0.0.1",
                    "server_port": 1883,
                    "server_protocol": "mqtt",
                    "timer_period_ms": 100
                },
                "event_storage": {
                    "enable": true,
                    "storage_path": "./"
                }
            }
        }
    }
}
