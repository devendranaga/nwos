{
    "network_config": {
        "interface_list": [
            "lo",
            "dummy1"
        ],
        "packet_buf_pool_len": 1000,
        "parsed_pkt_buf_pool_len": 1000,
        "logging": {
            "debug_log_server_ip": "127.0.0.1",
            "debug_log_server_port": 12000,
            "log_pcap": true,
            "pcap_file_path": "./netos_pcap",
            "pcap_file_size_MB": 100
        },
        "vlan_config": {
            "vlan_mapping": [
                {
                    "interface_name": "dummy0",
                    "vlan_ids": [
                        {
                            "ingress_vlan_id": 10,
                            "egress_vlan_id": 10
                        },
                        {
                            "ingress_vlan_id": 11,
                            "egress_vlan_id": 11
                        },
                        {
                            "ingress_vlan_id": 12,
                            "egress_vlan_id": 12
                        }
                    ]
                },
                {
                    "interface_name": "dummy1",
                    "vlan_ids": [
                        {
                            "ingress_vlan_id": 10,
                            "egress_vlan_id": 10
                        },
                        {
                            "ingress_vlan_id": 11,
                            "egress_vlan_id": 11
                        },
                        {
                            "ingress_vlan_id": 12,
                            "egress_vlan_id": 12
                        }
                    ]
                }
            ],
            "drop_double_tagged_vlan": false
        },
        "arp_config": {
            "arp_table_len": 64,
            "arp_query_timer_intvl_sec" : 1,
            "arp_cache_mgmt_timer_intvl_sec": 30
        },
        "ipv4_config": {
            "ipv4_ip_type": "static",
            "ipv4_ip_address": "192.168.0.1"
        },
        "filter": {
            "drop_ipv4_fragments": true,
            "icmp_max_payload_len": 0,
            "bypass_ipv4_checksum_verification": false
        },
        "egress": {
            "number_of_queues": 8,
            "egress_algorithm": "round_robin"
        },
        "ids": {
            "events": {
                "event_forwarding": {
                    "enable": false,
                    "server_ip": "127.0.0.1",
                    "server_port": 1883,
                    "server_protocol": "mqtt",
                    "timer_period_ms": 100
                },
                "event_storage": {
                    "enable": true,
                    "storage_path": "./"
                }
            }
        }
    }
}
